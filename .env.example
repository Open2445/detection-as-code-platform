# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dacuser
POSTGRES_PASSWORD=dacpassword
POSTGRES_DB=dacdb

# ─── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dac.db
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development

# Auto-seed DB with 20 Sigma rules on startup
SEED_ON_STARTUP=true
